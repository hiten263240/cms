{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blog"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string"
    },
    "Slug": {
      "type": "string"
    },
    "Category": {
      "type": "enumeration",
      "enum": [
        "API Reference",
        "  Integration Guide",
        "  User Guide",
        "  Architecture",
        "  How-to",
        "  FAQ",
        "  Release Notes",
        "  Operations",
        "  Thought Leadership",
        "  Product Updates",
        "  Case Study",
        "  Industry Insights",
        "  Engineering",
        "  Customer Story"
      ]
    },
    "Summary": {
      "type": "text"
    },
    "Tag": {
      "type": "customField",
      "customField": "plugin::tagsinput.tags"
    },
    "RevisionNote": {
      "type": "text"
    },
    "RTE": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    }
  }
}
