{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "ProductName": {
      "type": "string",
      "required": true
    },
    "Slug": {
      "type": "string"
    },
    "Description": {
      "type": "text"
    },
    "Category": {
      "type": "enumeration",
      "enum": [
        "Process Delivery",
        "Voice Governance",
        "Unified Runtime",
        "Proactive Engagement",
        "Analytics",
        "Healthcare"
      ]
    },
    "AccessLevel": {
      "type": "enumeration",
      "enum": [
        "Public",
        "Partner",
        "Customer",
        "Internal"
      ]
    },
    "owner": {
      "type": "string"
    },
    "ProductStatus": {
      "type": "enumeration",
      "enum": [
        "Active",
        "Draft",
        "Archived"
      ]
    },
    "WebsiteURL": {
      "type": "string",
      "regex": "https?://...*"
    },
    "Tag": {
      "type": "customField",
      "customField": "plugin::tagsinput.tags"
    }
  }
}
